<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Sts2McpBridge.Server</AssemblyName>
    <RootNamespace>Sts2McpBridge.Server</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Server/**/*.cs" />
    <Compile Remove="src/Core/**/*.cs;src/Mod/**/*.cs;tests/**/*.cs" />
    <ProjectReference Include="Sts2McpBridge.Core.csproj" />
  </ItemGroup>
</Project>
